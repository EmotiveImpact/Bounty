# Optional server-side settings. Copy to .env (which git ignores) and use only
# with authorised accounts. Values stay on the server: the API and the Sources
# tab report only whether each one is set. See docs/INTEGRATIONS.md for the
# acceptance run that proves each credential works.

# Where the SQLite database lives (default .data).
# BOUNTY_DATA_DIR=.data

# Hobnight supermarket catalogue: a personal access token from Admin, API Keys.
HOBNIGHT_API_KEY=

# Keepa: an API key with an active paid plan. Each lookup consumes tokens.
KEEPA_API_KEY=

# eBay Browse: a production application access token (client credentials
# grant, scope https://api.ebay.com/oauth/api_scope). It expires; renew it
# before each research session.
EBAY_ACCESS_TOKEN=

# Reserved for a future Fuel Finder connector (OAuth 2.0 client credentials
# from the GOV.UK developer portal). Not read by any code yet.
# FUEL_FINDER_CLIENT_ID=
# FUEL_FINDER_CLIENT_SECRET=
