{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": {
    "deploymentEnabled": { "fix/durable-snapshot-recovery": false }
  },
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "regions": ["lhr1"],
  "functions": {
    "api/index.mjs": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "CDN-Cache-Control", "value": "no-store" }]
    }
  ]
}
