{
  "name": "bounty-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.mjs",
    "api": "node --env-file-if-exists=.env server/api.mjs",
    "start": "node server/start.mjs",
    "worker": "node server/worker.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test server/*.test.mjs",
    "research": "node --env-file-if-exists=.env server/research.mjs",
    "worker:loop": "node server/loop.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "csv-parse": "^6.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
