{
  "name": "bounty-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env apps/server/dev.mjs",
    "api": "node --env-file-if-exists=.env apps/server/api.mjs",
    "start": "node apps/server/start.mjs",
    "worker": "node apps/server/worker.mjs",
    "build": "tsc --noEmit -p apps/web && vite build apps/web",
    "test": "node --test apps/server/*.test.mjs",
    "e2e": "node --test e2e/*.e2e.mjs",
    "research": "node --env-file-if-exists=.env apps/server/research.mjs",
    "worker:loop": "node apps/server/loop.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "barcode-detector": "3.2.2",
    "csv-parse": "^6.2.1",
    "radix-ui": "1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
